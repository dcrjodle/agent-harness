# Copy to .env (gitignored). Agents pass keys by reference (source, --env-file) — never read, print, or commit values.
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TypeSafe AI (Jev), used only by bin/decide; without it every decision takes its fallback.
TYPESAFE_API_KEY=
# Supabase (the project Cockpit reads), used only by bin/session-log for the session log: the project URL
# and its secret key (sb_secret_…), which bypasses row level security, so it stays in this file. Without
# both, session events wait in logs/session-outbox/.
COCKPIT_SUPABASE_URL=
COCKPIT_SUPABASE_SECRET_KEY=
