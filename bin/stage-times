#!/usr/bin/env bash
# Minutes and tokens per sub-agent from the stage log. Resumed agents count only their active runs.
# usage: stage-times [N]       last N agents (default 20)
#        stage-times --roles   averages per role and model
set -euo pipefail
log="${HARNESS_STAGE_LOG:-$HOME/.agent-harness/logs/stages.tsv}"
[ -f "$log" ] || { echo "no stage log yet ($log)"; exit 0; }
mode="agents"; n="${1:-20}"
[ "${1:-}" = "--roles" ] && { mode="roles"; n=0; }
jq -Rrn --arg mode "$mode" --argjson n "$n" '
  def num: (tonumber? // null);
  def r1: (. * 10 | round) / 10;
  [inputs | split("\t") | {t: (.[0] | fromdate), ev: .[1], type: .[2], id: .[3],
    model: .[6], cr: (.[8] // "" | num), cw: (.[9] // "" | num), out: (.[10] // "" | num)}]
  | group_by(.id)
  | map(sort_by(.t) as $ev
      | [$ev[] | select(.ev == "SubagentStart")] as $s
      | select($s | length > 0)
      | {t: $s[0].t, type: $s[0].type, runs: ($s | length),
         min: ([range(0; $s | length) as $i | $s[$i].t as $a | (($s[$i + 1].t) // 1e12) as $b
                | [$ev[] | select(.ev == "SubagentStop" and .t >= $a and .t < $b)]
                | if length > 0 then .[-1].t - $a else 0 end] | add / 60),
         u: ([$ev[] | select(.ev == "SubagentStop" and .cr != null)] | last)})
  | if $mode == "roles" then
      group_by([.type, (.u.model // "-")])[]
      | length as $k
      | [.[0].type, (.[0].u.model // "-"), "n=\($k)", "\(map(.min) | add / $k | r1) min",
         (map(select(.u)) | if length == 0 then "-", "-" else length as $m
           | "\(map(.u.cr) | add / $m / 1e6 | r1)M read", "\(map(.u.out) | add / $m / 1e3 | round)k out" end)] | @tsv
    else
      sort_by(.t) | .[-$n:][]
      | [(.t | todate), .type, (.u.model // "-"), "runs=\(.runs)", "\(.min | r1) min",
         (if .u then "\(.u.cr / 1e6 | r1)M read, \(.u.cw / 1e3 | round)k write, \(.u.out / 1e3 | round)k out" else "-" end)] | @tsv
    end' "$log" | column -t -s $'\t'
