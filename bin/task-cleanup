#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
root="$(harness_repo_root "${1:-$PWD}")" || { echo "not a git repo" >&2; exit 1; }
name="$(basename "$root")"
cd "$root"
git worktree list --porcelain | awk '/^worktree /{p=$2} /^branch /{sub("refs/heads/","",$2); print p" "$2}' |
while read -r path branch; do
  case "$path" in "$HOME/.agent-worktrees/$name/"*) ;; *) continue ;; esac
  pr_json="$(gh pr list --head "$branch" --state all --json state,headRefOid --limit 1 2>/dev/null || echo '[]')"
  state="$(printf '%s' "$pr_json" | jq -r '.[0].state // "NONE"')"
  head_oid="$(printf '%s' "$pr_json" | jq -r '.[0].headRefOid // ""')"
  local_oid="$(git rev-parse "$branch" 2>/dev/null || echo "")"
  if [ "$state" = "MERGED" ] && [ -n "$head_oid" ] && [ "$head_oid" = "$local_oid" ]; then
    if [ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
      if git worktree remove "$path" && git branch -D "$branch" >/dev/null; then
        rm -rf "$path.handoff"
        echo "removed $path ($branch)"
      else
        echo "failed to remove $path ($branch)" >&2
      fi
    else
      echo "kept $path ($branch, merged but worktree is dirty)"
    fi
  else
    echo "kept $path ($branch, PR $state)"
  fi
done
git worktree prune
